rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'analyst'
      );
    }

    match /incidentPhotos/{incidentId}/{fileName} {
      // Private photos are never public-listable or token-downloadable.
      allow get: if isAdmin() && fileName == 'photo.jpg';
      // Only uploadIncidentPhoto may create token-free private objects through GCS.
      allow create, update: if false;
      allow delete: if isAdmin() && fileName == 'photo.jpg';
    }
  }
}
