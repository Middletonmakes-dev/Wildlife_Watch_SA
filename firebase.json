{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  },
  "emulators": {
    "auth": {"port": 19099},
    "functions": {"port": 15001},
    "firestore": {"port": 18080},
    "storage": {"port": 19199},
    "hub": {"port": 14400},
    "logging": {"port": 14500},
    "ui": {"enabled": false}
  }
}
