# Demo mode is the safe default. Real Firebase configuration is generated by FlutterFire.
USE_FIREBASE=false
FIREBASE_PROJECT_ID=replace-with-your-project-id
PUBLIC_COORDINATE_RADIUS_MIN_METRES=20
PUBLIC_COORDINATE_RADIUS_MAX_METRES=50
PHOTO_MAX_BYTES=2097152
PHOTO_MAX_LONGEST_EDGE=1600
SUPPORT_URL=
APP_CHECK_WEB_KEY=replace-with-your-recaptcha-v3-site-key
USE_FIREBASE_EMULATORS=false
FIREBASE_EMULATOR_HOST=127.0.0.1
AUTH_EMULATOR_PORT=19099
FUNCTIONS_EMULATOR_PORT=15001
FIRESTORE_EMULATOR_PORT=18080
STORAGE_EMULATOR_PORT=19199
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
